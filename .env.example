# Copied to .env by `make env`, which also generates JWT_PRIVATE_KEY.
# Development values only: never reuse them in production.
POSTGRES_USER=sys_called
POSTGRES_PASSWORD=sys_called
POSTGRES_DB=sys_called
# Port of the app (frontend + API) on the host.
APP_PORT=8000
# Keep true. Set to false only on hosts where containers fail to start with
# "exec ...: operation not permitted" (Docker 29 on kernel 7).
NO_NEW_PRIVILEGES=true
# Ed25519 private key (PKCS8 PEM) that signs the access tokens. Empty means an
# ephemeral key: sessions do not survive a restart.
JWT_PRIVATE_KEY=